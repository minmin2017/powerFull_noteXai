node_modules/
data/
.claude/
.env
*.log
.setup/

# graphify: track the graph outputs, ignore machine-specific state
graphify-out/.graphify_python
graphify-out/cache/
graphify-out/.cdp-profile/

# external cloned repos (have own .git)
videos/
manim-community/
# junk files from windows-path bug
D:\\*

# python bytecode / daemon state
__pycache__/
*.pyc
.last_voice_ts.txt
.notify_daemon_seen_ts.txt

# scratch output from agent runs
reply*.json
*.log.err
temp_tts.mp3

# tools/: keep sources, drop build output and throwaway screenshots
tools/**/bin/
tools/**/obj/
tools/*.png

# nested clones with their own .git (not submodules)
tools/TIA_Portal_Openness_MCP/
tools/tiaportal-mcp/

# study-app: ignore video data, keep the directory structure
study-app/data/*
!study-app/data/.gitkeep

# mkcert-generated local TLS cert/key — machine-specific, never commit
certs/*.pem

# real OAuth token for Gmail — secret, never commit
.gmail_token.pickle

# Manim render cache / extracted-frame scratch output — regenerable, not source
media/
frames_part3/
frames_part3_fixed/

# explicit scratch/throwaway work area — not meant to be versioned
scratch/

# one-off "send a single message" scripts left at repo root from past sessions —
# kept on disk for reference, just not versioned (dozens of these, each a
# throwaway single-purpose script, e.g. send_lambda_h_relation.py)
send_*.py
